# =================================================================
# HOSPITAL MANAGEMENT SYSTEM - HOSTINGER + SUPABASE AUTH CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. HOSTINGER MYSQL PRODUCTION DATABASE CONFIGURATION
# -----------------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# -----------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION CONFIGURATION (AUTH ONLY)
# -----------------------------------------------------------------
# Obtain these values from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# -----------------------------------------------------------------
# 3. BACKEND SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=your_backend_jwt_secret_token_fallback

# -----------------------------------------------------------------
# 4. BACKUP SYSTEM & RETENTION POLICIES
# -----------------------------------------------------------------
# Storage location on Hostinger server (must be outside public_html)
BACKUP_STORAGE_PATH=/home/your_username/backups

# Retention Rules (Number of days/weeks/months to preserve)
# Note: Backups NEVER delete live database data; only expired backup files are cleaned.
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4
BACKUP_RETENTION_MONTHLY_MONTHS=12

# Off-Site Storage Integration (Optional: google_drive, s3, onedrive, or none)
OFFSITE_STORAGE_ENABLED=false
OFFSITE_STORAGE_TYPE=none
