# LifeFlow HMS - Hostinger MySQL Environment Configuration

# Database Engine
DB_DIALECT=mysql

# Hostinger Remote MySQL Host IP or Hostname (e.g. 193.109.85.12 or sql123.main-hosting.com)
DB_HOST=your_hostinger_mysql_host_or_ip
DB_PORT=3306

# Hostinger Database Name (e.g. u123456789_hms_db)
DB_NAME=your_hostinger_database_name

# Hostinger Database User (e.g. u123456789_hms_user)
DB_USER=your_hostinger_database_user

# Hostinger Database Password
DB_PASSWORD=your_hostinger_database_password

# Application Secret Keys
JWT_SECRET=lifeflow_jwt_secret_token_key_for_hms_application_2026
JWT_REFRESH_SECRET=lifeflow_refresh_token_secret_key_2026
NODE_ENV=production
