# ========================================================
# HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ========================================================
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hms_database
DB_USER=hms_user
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret_key
PORT=5000
NODE_ENV=production

# ========================================================
# GOOGLE DRIVE AUTOMATED OFFSITE BACKUP CONFIGURATION
# ========================================================
OFFSITE_STORAGE_ENABLED=true
OFFSITE_STORAGE_TYPE=google_drive
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Option 1: Service Account JSON String
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: Or OAuth2 Refresh Token credentials
# GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token
